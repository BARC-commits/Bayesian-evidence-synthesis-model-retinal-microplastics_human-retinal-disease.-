# 4c: LR distributions
ax = axes[1, 0]
box_data = [lr_samples[key] for key in evidence_nodes.keys()]
labels_lr = [evidence_nodes[key]['label'].replace('\n', ' ') for key in evidence_nodes.keys()]
colors_lr = ['#2C3E50', '#E74C3C', '#95A5A6', '#F39C12']

