for i, (key, node) in enumerate(evidence_nodes.items()):
    lr_samples_node = lr_samples[key]
    lr_low = np.percentile(lr_samples_node, 2.5)
    lr_high = np.percentile(lr_samples_node, 97.5)
    lr_base = node['LR']
    
    lrs_all_low = all_lrs.copy()
    lrs_all_low[i] = lr_low
    post_low, _, _ = compute_posterior(prior, lrs_all_low)
    
    lrs_all_high = all_lrs.copy()
    lrs_all_high[i] = lr_high
    post_high, _, _ = compute_posterior(prior, lrs_all_high)
    
    tornado_data.append({
        'Evidence': node['label'].replace('\n', ' '),
        'LR_Low': lr_low,
        'LR_High': lr_high,
        'Posterior_Low': post_low,
        'Posterior_Base': final_posterior,
        'Posterior_High': post_high,
        'Range': post_high - post_low
    })

tornado_df = pd.DataFrame(tornado_data)
tornado_df = tornado_df.sort_values('Range', ascending=True)

fig, ax = plt.subplots(figsize=(12, 6))

y_pos = range(len(tornado_df))

for i, (idx, row) in enumerate(tornado_df.iterrows()):
    width_low = row['Posterior_Base'] - row['Posterior_Low']
    width_high = row['Posterior_High'] - row['Posterior_Base']
    
    ax.barh(i, width_low, left=row['Posterior_Low'], height=0.5,
            color='#3498DB', edgecolor='white', linewidth=0.8, alpha=0.8)
    ax.barh(i, width_high, left=row['Posterior_Base'], height=0.5,
            color='#E74C3C', edgecolor='white', linewidth=0.8, alpha=0.8)
    
    ax.text(row['Posterior_Low'] - 0.025, i, f'LR={row["LR_Low"]:.2f}',
            ha='right', va='center', fontsize=8, color='#3498DB')
    ax.text(row['Posterior_High'] + 0.025, i, f'LR={row["LR_High"]:.2f}',
            ha='left', va='center', fontsize=8, color='#E74C3C')

ax.axvline(x=final_posterior, color='black', linestyle='--', linewidth=1.5,
           alpha=0.7, label=f'Base illustrative posterior = {final_posterior:.3f}')
ax.axvline(x=prior, color='#2C3E50', linestyle=':', linewidth=1.5, alpha=0.7,
           label=f'Prior = {prior:.2f}')

ax.set_yticks(y_pos)
ax.set_yticklabels(tornado_df['Evidence'], fontsize=10)
ax.set_xlabel('Illustrative Posterior Probability P(H | Evidence)', fontsize=12, fontweight='bold')
ax.set_title('Figure 2: Tornado Plot — Sensitivity of Illustrative Posterior\n'
             '(2.5th–97.5th percentile LR ranges from Monte Carlo)',
             fontsize=13, fontweight='bold', pad=15)
ax.legend(fontsize=9, loc='lower right')
ax.set_xlim(0, max(tornado_df['Posterior_High']) * 1.2)
ax.grid(axis='x', alpha=0.25)

plt.tight_layout()
plt.savefig('figure2_tornado_plot.png', dpi=300, bbox_inches='tight')
plt.show()
print("✓ Figure 2 saved: figure2_tornado_plot.png\n")

