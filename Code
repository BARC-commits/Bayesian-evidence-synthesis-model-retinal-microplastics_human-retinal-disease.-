cbar = plt.colorbar(im, ax=ax, label='Illustrative Posterior P(H | Evidence)', shrink=0.85)
cbar.ax.tick_params(labelsize=10)

ax.set_xlabel('Prior Probability P(H)', fontsize=12, fontweight='bold')
ax.set_ylabel('Likelihood Ratio for E₂ (Mechanistic Evidence)', fontsize=12, fontweight='bold')
ax.set_title('Figure 3: Sensitivity Heatmap — Illustrative Posterior vs. Prior and Mechanistic LR\n'
             '(Other LRs held at base-case values)',
             fontsize=13, fontweight='bold', pad=15)
ax.legend(fontsize=10, loc='upper left')

