#!/usr/bin/env python3
"""
Bayesian Evidence Synthesis: Retinal Microplastics and Disease Causality
========================================================================
Implements the conceptual framework from:
"A Bayesian Conceptual Framework for Evaluating the Potential 
Pathogenicity of Retinal Microplastics: Methodological Demonstration 
and Illustrative Application"

This is a conceptual Bayesian reasoning framework, not a formal 
quantitative risk assessment. All posterior probabilities are conditional 
outputs of the specified assumptions and should be interpreted as 
illustrative demonstrations rather than empirical measurements of 
biological causality.

Kaggle Notebook Compatible
"""

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from scipy.stats import gaussian_kde, beta
import warnings
warnings.filterwarnings('ignore')

# Set style for publication-quality figures
plt.style.use('seaborn-v0_8-whitegrid')
sns.set_context("paper", font_scale=1.2)
plt.rcParams['figure.dpi'] = 150
plt.rcParams['savefig.dpi'] = 300
plt.rcParams['figure.figsize'] = (10, 6)
plt.rcParams['font.family'] = 'serif'

# ============================================================================
# 1. CORE BAYESIAN MODEL
# ============================================================================

def compute_posterior(prior, likelihood_ratios):
    """
    Compute posterior probability from prior and list of LRs.
    
    Parameters
    ----------
    prior : float
        Prior probability P(H)
    likelihood_ratios : list of float
        Likelihood ratios LR_i = P(E_i | H) / P(E_i | ¬H)
    
    Returns
    -------
    posterior : float
        Posterior probability P(H | E_1,...,E_n)
    posterior_odds : float
        Posterior odds
    total_lr : float
        Total likelihood ratio (product of all LRs)
    """
    prior_odds = prior / (1 - prior)
    total_lr = np.prod(likelihood_ratios)
    posterior_odds = prior_odds * total_lr
    posterior = posterior_odds / (1 + posterior_odds)
    return posterior, posterior_odds, total_lr

# ============================================================================
# 2. EVIDENCE NODE DEFINITIONS
# ============================================================================

# Define evidence nodes with conditional probabilities
evidence_nodes = {
    'E1': {
        'label': 'Detection in\nHuman Retina',
        'full_label': 'E₁: MPs Detected in Human Retina',
        'p_E_given_H': 0.95,
        'p_E_given_notH': 0.80,
        'description': 'Zhang et al. (2025) confirmed MPs in retinal tissue',
        'beta_H': {'a': 19, 'b': 1},
        'beta_notH': {'a': 16, 'b': 4}
    },
    'E2': {
        'label': 'Mechanistic\nToxicology',
        'full_label': 'E₂: Convergent Mechanistic Evidence',
        'p_E_given_H': 0.90,
        'p_E_given_notH': 0.25,
        'description': 'BRB disruption, apoptosis, oxidative stress, inflammation',
        'beta_H': {'a': 18, 'b': 2},
        'beta_notH': {'a': 5, 'b': 15}
    },
    'E3': {
        'label': 'Absence of\nEpidemiology',
        'full_label': 'E₃: Absence of Human Epidemiological Data',
        'p_E_given_H': 0.70,
        'p_E_given_notH': 0.95,
        'description': 'No cohort/case-control studies conducted to date',
        'beta_H': {'a': 14, 'b': 6},
        'beta_notH': {'a': 19, 'b': 1}
    },
    'E4': {
        'label': 'HRF–Disease\nAssociation',
        'full_label': 'E₄: HRF Associated with Retinal Disease',
        'p_E_given_H': 0.95,
        'p_E_given_notH': 0.85,
        'description': 'HRF predict progression in DR, AMD, RVO',
        'beta_H': {'a': 19, 'b': 1},
        'beta_notH': {'a': 17, 'b': 3}
    }
}

# Compute LRs for each node
for key in evidence_nodes:
    node = evidence_nodes[key]
    node['LR'] = node['p_E_given_H'] / node['p_E_given_notH']

# ============================================================================
# 3. PRIMARY ANALYSIS: SEQUENTIAL BAYESIAN UPDATE
# ============================================================================

print("=" * 80)
print("PRIMARY ANALYSIS: SEQUENTIAL BAYESIAN UPDATE")
print("=" * 80)
print("\nIMPORTANT: This is a conceptual demonstration framework.")
print("Posterior probabilities are conditional on specified assumptions")
print("and should NOT be interpreted as empirical risk estimates.\n")

prior = 0.10
print(f"Prior P(H) = {prior:.3f} (Prior odds = {prior/(1-prior):.4f})")
print("Hypothesis H: Retinal microplastics act as biologically relevant\n"
      "            risk modifiers in retinal disease progression.\n")

# Sequential update
results_table = []
all_lrs = [evidence_nodes[key]['LR'] for key in evidence_nodes.keys()]

# Add prior row
results_table.append({
    'Step': 0,
    'Evidence': 'Prior only',
    'LR_increment': 1.00,
    'Cumulative_LR': 1.00,
    'Posterior_Odds': prior/(1-prior),
    'Posterior_P_H': prior
})

for i, (key, node) in enumerate(evidence_nodes.items(), 1):
    lrs_so_far = all_lrs[:i]
    current_posterior, posterior_odds, cumulative_lr = compute_posterior(prior, lrs_so_far)
    
    results_table.append({
        'Step': i,
        'Evidence': node['full_label'],
        'LR_increment': node['LR'],
        'Cumulative_LR': cumulative_lr,
        'Posterior_Odds': posterior_odds,
        'Posterior_P_H': current_posterior
    })
    
    label_clean = node['label'].replace('\n', ' ')
    print(f"Step {i}: + {label_clean}")
    print(f"  LR = {node['LR']:.3f} | Cumulative LR = {cumulative_lr:.3f}")
    print(f"  Illustrative Posterior P(H) = {current_posterior:.4f} ({current_posterior*100:.2f}%)")
    print()

results_df = pd.DataFrame(results_table)
final_posterior = results_df['Posterior_P_H'].iloc[-1]

print("─" * 60)
print(f"ILLUSTRATIVE POSTERIOR ESTIMATE (under base-case assumptions):")
print(f"  {final_posterior:.4f} ({final_posterior*100:.2f}%)")
print(f"Posterior odds: {results_df['Posterior_Odds'].iloc[-1]:.4f}")
print(f"Total LR: {results_df['Cumulative_LR'].iloc[-1]:.4f}")
print("─" * 60)
print()

# ============================================================================
# 4. FIGURE 1: STEPWISE POSTERIOR UPDATE
# ============================================================================

fig, ax = plt.subplots(figsize=(12, 7))

steps = ['Prior'] + [node['label'] for node in evidence_nodes.values()]
posteriors = [prior] + [results_df['Posterior_P_H'].iloc[i] for i in range(1, 5)]
lrs = [1.0] + [node['LR'] for node in evidence_nodes.values()]

colors = ['#2C3E50'] + ['#E74C3C'] * 4
bars = ax.bar(range(len(steps)), posteriors, color=colors, 
              edgecolor='white', linewidth=1.5, alpha=0.85)

# Add annotations
for i, (bar, lr, post) in enumerate(zip(bars, lrs, posteriors)):
    height = bar.get_height()
    if i == 0:
        ax.text(bar.get_x() + bar.get_width()/2., height + 0.015,
                f'Prior = {post:.2f}', ha='center', va='bottom', 
                fontsize=10, fontweight='bold')
    else:
        ax.text(bar.get_x() + bar.get_width()/2., height + 0.015,
                f'LR = {lr:.2f}', ha='center', va='bottom', 
                fontsize=10, fontweight='bold')
        if height > 0.12:
            ax.text(bar.get_x() + bar.get_width()/2., height/2,
                    f'{post:.3f}', ha='center', va='center', 
                    fontsize=11, fontweight='bold', color='white')

ax.set_xticks(range(len(steps)))
ax.set_xticklabels(steps, fontsize=10)
ax.set_ylabel('Illustrative Posterior Probability P(H | Evidence)', fontsize=12, fontweight='bold')
ax.set_title('Figure 1: Sequential Bayesian Update — Illustrative Posterior Estimates',
             fontsize=14, fontweight='bold', pad=15)
ax.set_ylim(0, max(posteriors) * 1.3)
ax.axhline(y=prior, color='#2C3E50', linestyle='--', linewidth=1.5, 
           alpha=0.6, label=f'Prior = {prior:.2f}')
ax.legend(fontsize=10, loc='upper left')
ax.grid(axis='y', alpha=0.25)

plt.tight_layout()
plt.savefig('figure1_stepwise_update.png', dpi=300, bbox_inches='tight')
plt.show()
print("✓ Figure 1 saved: figure1_stepwise_update.png\n")

# ============================================================================
# 5. SENSITIVITY ANALYSES
# ============================================================================

print("=" * 80)
print("SENSITIVITY ANALYSES")
print("=" * 80)

# 5a. Varying the prior
priors_to_test = [0.01, 0.03, 0.05, 0.10, 0.15, 0.20, 0.25, 0.30, 0.40, 0.50]

prior_sensitivity = []
for p in priors_to_test:
    post, _, _ = compute_posterior(p, all_lrs)
    prior_sensitivity.append({'Prior': p, 'Illustrative_Posterior': post})

prior_sens_df = pd.DataFrame(prior_sensitivity)
print("\nSensitivity to Prior Probability:")
print(prior_sens_df.to_string(index=False))
print()

# 5b. Varying the mechanistic LR (E2)
lr2_range = np.linspace(1.0, 9.0, 17)
lr2_sensitivity = []

for lr2 in lr2_range:
    modified_lrs = all_lrs.copy()
    modified_lrs[1] = lr2
    post, _, _ = compute_posterior(prior, modified_lrs)
    lr2_sensitivity.append({'LR_E2': lr2, 'Illustrative_Posterior': post})

lr2_sens_df = pd.DataFrame(lr2_sensitivity)

# 5c. Dependence-adjusted total LR
dependence_factors = [1.0, 0.75, 0.50, 0.25]
dependence_sensitivity = []

base_total_lr = np.prod(all_lrs)
for factor in dependence_factors:
    adjusted_lr = base_total_lr * factor
    post, _, _ = compute_posterior(prior, [adjusted_lr])
    dependence_sensitivity.append({
        'Dependence_Adjustment': f'{int(factor*100)}%',
        'Adjusted_Total_LR': adjusted_lr,
        'Illustrative_Posterior': post
    })

dep_sens_df = pd.DataFrame(dependence_sensitivity)
print("\nSensitivity to Dependence Among Evidence Nodes:")
print(dep_sens_df.to_string(index=False))
print()

# ============================================================================
# 6. MONTE CARLO UNCERTAINTY PROPAGATION
# ============================================================================

print("=" * 80)
print("MONTE CARLO UNCERTAINTY PROPAGATION")
print("=" * 80)

n_simulations = 100000
np.random.seed(42)

posterior_samples = np.zeros(n_simulations)
lr_samples = {key: np.zeros(n_simulations) for key in evidence_nodes.keys()}
total_lr_samples = np.zeros(n_simulations)

print(f"Running {n_simulations:,} simulations...")

for sim in range(n_simulations):
    lrs = []
    for key in evidence_nodes.keys():
        params = evidence_nodes[key]
        p_h = np.random.beta(params['beta_H']['a'], params['beta_H']['b'])
        p_not_h = np.random.beta(params['beta_notH']['a'], params['beta_notH']['b'])
        lr = p_h / p_not_h
        lrs.append(lr)
        lr_samples[key][sim] = lr
    
    total_lr = np.prod(lrs)
    total_lr_samples[sim] = total_lr
    posterior_samples[sim], _, _ = compute_posterior(prior, lrs)
    
    if (sim + 1) % 20000 == 0:
        print(f"  Completed {sim+1:,} simulations...")

print("Simulation complete.\n")

# Summary statistics
posterior_median = np.median(posterior_samples)
posterior_mean = np.mean(posterior_samples)
posterior_ci_95 = np.percentile(posterior_samples, [2.5, 97.5])
posterior_ci_50 = np.percentile(posterior_samples, [25, 75])

print("Monte Carlo Results (100,000 iterations):")
print(f"  Prior: {prior:.3f}")
print(f"  Illustrative Posterior Median: {posterior_median:.4f} ({posterior_median*100:.2f}%)")
print(f"  Illustrative Posterior Mean:   {posterior_mean:.4f} ({posterior_mean*100:.2f}%)")
print(f"  95% Credible Interval: [{posterior_ci_95[0]:.4f}, {posterior_ci_95[1]:.4f}]")
print(f"                        [{posterior_ci_95[0]*100:.1f}%, {posterior_ci_95[1]*100:.1f}%]")
print(f"  50% Credible Interval: [{posterior_ci_50[0]:.4f}, {posterior_ci_50[1]:.4f}]")
print(f"                        [{posterior_ci_50[0]*100:.1f}%, {posterior_ci_50[1]*100:.1f}%]")
print()

